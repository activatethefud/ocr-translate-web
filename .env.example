# ---- vision model provider ----
# API key is read from this env var; never commit the real key.
DS_KEY=
API_BASE=https://api.deepseek.com/chat/completions
DEFAULT_MODEL=deepseek-flash

# ---- storage / db ----
DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./data

# ---- limits / sane defaults ----
MAX_UPLOAD_MB=200
MAX_PAGES=1000
MAX_JOB_USD=2.00
WORKER_CONCURRENCY=3        # concurrent jobs
PAGE_CONCURRENCY=4          # pages translated in parallel within a job
CORS_ORIGINS=http://localhost:5173

# ---- session BYOK encryption ----
# Optional. If unset, a Fernet key is generated at STORAGE_DIR/secret.key (0600).
# API keys are stored encrypted per browser session and never returned to clients.
SECRET_KEY=

# ---- abuse protection (see ABUSE_PROTECTION.md) ----
# APP_MODE=public           # local | team | public; public => BYOK mandatory + limits on disables all limits (single user). Set team/public to enforce.
APP_MODE=public           # local | team | public; public => BYOK mandatory + limits on
JOB_COOLDOWN_SECONDS=5
MAX_ACTIVE_JOBS_PER_SESSION=1
MAX_JOBS_PER_HOUR=10
DEDUPE_WINDOW=60
MAX_DAILY_USD=1.00
# ---- edge / rate limiting (see ABUSE_PROTECTION.md) ----
TRUST_PROXY=1               # read the real client IP from X-Forwarded-For (behind nginx)
RATE_LIMIT_PER_MIN=120      # weighted units per minute per client
RATE_BURST=40
MAX_SSE_PER_SESSION=3
ADMIN_TOKEN=                # set to enable GET /api/admin/stats (X-Admin-Token)
